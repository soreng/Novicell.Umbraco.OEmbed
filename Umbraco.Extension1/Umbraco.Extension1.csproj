<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Umbraco.Extension1</PackageId>
        <Product>Umbraco.Extension1</Product>
        <Title>Umbraco.Extension1</Title>
    </PropertyGroup>


    <ItemGroup>
        <PackageReference Include="Umbraco.Cms.Web.Website" VersionOverride="17.0.0"/>
        <PackageReference Include="Umbraco.Cms.Web.Common" VersionOverride="17.0.0"/>
        <PackageReference Include="Umbraco.Cms.Api.Common" VersionOverride="17.0.0"/>
        <PackageReference Include="Umbraco.Cms.Api.Management" VersionOverride="17.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Dont include the client folder as part of packaging nuget build -->
        <Content Remove="Client\**"/>

        <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
        <None Include="Client\public\umbraco-package.json" Pack="false"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Client\src\api\" />
        <Folder Include="wwwroot\"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\src\Novicell.OEmbed.Core\Novicell.OEmbed.Core.csproj" />
    </ItemGroup>

</Project>
