<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <UmbracoVersion>17.4.0</UmbracoVersion>
  </PropertyGroup>
  <!-- Global packages (private, build-time packages for all projects) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.6" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageVersion Include="Umbraco.Cms" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="$(UmbracoVersion)" />
  </ItemGroup>
</Project>