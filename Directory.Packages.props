<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!--
      The lowest Umbraco version the package supports (its major version is the package's major version),
      so a site on any 17.x can install it. The test site runs a newer Umbraco, see the test site block below.
    -->
    <UmbracoVersion>17.0.0</UmbracoVersion>
    <!--
      Must match UmbracoAppLocalIcuVersion in Novicell.Umbraco.OEmbed.TestSite.csproj. Defined here too because this file
      is imported before the project's own PropertyGroup runs, so under CPM the PackageVersion below needs its own
      fallback to stay in sync with the RuntimeHostConfigurationOption value set from the same property.
    -->
    <UmbracoAppLocalIcuVersion Condition="'$(UmbracoAppLocalIcuVersion)' == ''">72.1.0.3</UmbracoAppLocalIcuVersion>
  </PropertyGroup>
  <!-- Global packages (private, build-time packages for all projects) -->
  <ItemGroup>
    <!-- Transitive dependencies pinned to patched versions (NU1902/NU1903 audit warnings) -->
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.6" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="$(UmbracoVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test site: a newer Umbraco than the package supports, to run it on what a new site gets -->
    <PackageVersion Include="Umbraco.Cms" Version="17.7.1" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.7.1" />
    <PackageVersion Include="uSync" Version="17.3.2" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="$(UmbracoAppLocalIcuVersion)" />
  </ItemGroup>
</Project>