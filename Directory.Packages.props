<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!--
      The lowest Umbraco version the package supports (its major version is the package's major version),
      so a site on any 17.x can install it. The demo site runs a newer Umbraco, see its own props file.
    -->
    <UmbracoVersion>17.0.0</UmbracoVersion>
  </PropertyGroup>
  <!-- Global packages (private, build-time packages for all projects) -->
  <ItemGroup>
    <!-- Transitive dependencies pinned to patched versions (NU1902/NU1903 audit warnings) -->
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.6" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="$(UmbracoVersion)" />
  </ItemGroup>
</Project>